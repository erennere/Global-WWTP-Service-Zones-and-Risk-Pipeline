"""The WWTP pipeline as a Snakemake workflow.

Every stage runs through its own command line (python -m wwtp.<stage>); the
files each rule declares come from wwtp/workflow.py, which computes them with
the same config resolution and path helpers the stages use. Settings live in
wwtp/config.yaml and its layers (WWTP_CONFIG_OVERLAYS, wwtp/config.local.yaml),
SLURM resources in its `workflow` section.

Targets (run from the repository root; add --profile workflow/profiles/local or .../slurm, -n to only plan).
A run does only the part it names; `snakemake` alone lists the targets and runs nothing.
    snakemake service_areas     configured variant: service areas, population layers and their
                                HydroWASTE/UWWTD comparisons
    snakemake risk              configured variant, the rest: non-served population, river risk,
                                population differences, unconnected industrial areas
                                (makes the service areas first if they are missing)
    snakemake analysis          service_areas + risk
    snakemake figures           configured variant's figures (and whatever of the analysis they need)
    snakemake sweep             whole sweep grid: service areas + population, validated per plant (GB,
                                NL, US catchments; HydroWASTE/UWWTD) and per country and SDG region
                                (JMP, Eurostat, OECD), and the recommended candidate
                                (data/sensitivity/sweep_validation/summary.md)
        sweep_layers                  only the service areas + population of the grid
    snakemake national_data     downloads the validation references and national plant registers (on
                                the login node), lists the register plants our list lacks
                                (data/validation_data/national_data/new_plants.gpkg, results.zip)
    snakemake all               analysis + figures + sweep
    snakemake fig1              Figure 1 from its prepared inputs (see workflow/rules/fig1.smk)
    snakemake annotations --config run_once=annotations    grids, OSM context, annotated images, merged labels
    snakemake calibration       everything the calibration needs from the cluster, before any sweep:
                                national_data + the plant sizes by country, the national size scale and
                                the radius rule from national connection statistics (JMP; SDG 6.3.1,
                                Eurostat, OECD as checks), every configuration on the real catchments
                                (US, GB, NL, IE, ES) and census districts (MX), and the choice
                                (data/calibration/connection_radius/calibration_results.zip)
        connection_radius             only the calibration tables (wwtp/calibration/connection_radius.py)

One-time stages (combine_locations, the four annotation rules, download_pop) are left out
of every run: their outputs are taken as they are. Name them to include them in one run,
e.g. `snakemake analysis --config run_once=download_pop` (or list them in workflow.run_once).
Targets go before --config: it takes every word that follows it.

The first time on outputs made by the old shell wrappers, `snakemake --touch`
marks them as up to date instead of recomputing them.
"""
import os
import sys

from wwtp import workflow as wf

PY = sys.executable
DEFAULT = wf.default_variant()
SWEEP = wf.sweep_variants()
VARIANTS = list({v.tag: v for v in [DEFAULT, *SWEEP]}.values())  # the configured run is usually in the grid too
ONCE = wf.one_time_rules(config)  # one-time rules this run includes (default: none)


# One shell template for every stage. The module and arguments are params, because a
# shell string is only formatted when the job runs: a loop variable used in it would
# already hold its last value by then.
# Numerical libraries get the job's CPUs, not the whole node's.
THREADS = "export OMP_NUM_THREADS={threads} OPENBLAS_NUM_THREADS={threads} MKL_NUM_THREADS={threads} " \
          "NUMEXPR_NUM_THREADS={threads}; "
STAGE = THREADS + PY + " -m wwtp.{params.module} {params.cli:q} > {log} 2>&1"


def then(module, *extra):
    """A further stage in the same job, appending to the job's log."""
    return " && " + " ".join([PY, "-m", f"wwtp.{module}", *extra, "{params.cli:q}", ">> {log} 2>&1"])


def res(stage):
    r = wf.resources(stage)
    return {"mem_mb": r["mem_mb"], "runtime": r["runtime"]}


def threads(stage):
    return wf.resources(stage)["threads"]


TARGETS = {
    "service_areas": "configured variant: service areas, population layers, HydroWASTE/UWWTD comparisons",
    "risk": "configured variant: non-served population, river risk, population differences, industrial areas",
    "analysis": "service_areas + risk",
    "figures": "configured variant's figures (and whatever of the analysis they need)",
    "sweep": "whole sweep grid: service areas + population, validation and the recommended candidate",
    "sweep_layers": "only the service areas + population of the sweep grid",
    "national_data": "reference data downloaded (login node), national registers: plants our list lacks",
    "all": "analysis + figures + sweep",
    "fig1": "Figure 1 from its prepared inputs",
    "annotations": "grids, OSM context, images, labels: `snakemake annotations --config run_once=annotations`",
    "calibration": "before any sweep: national_data + size and radius calibration tables, in one zip to send back",
    "connection_radius": "only the calibration tables: plant sizes by country, national size scale, radius rule",
}


rule help:
    """The default target: runs nothing and lists the targets, so a run always names its part."""
    localrule: True
    run:
        print("Name what to run, e.g. `snakemake --profile workflow/profiles/slurm analysis`:")
        for target, what in TARGETS.items():
            print(f"  {target:<12} {what}")


# --------------------------------------------------------------------------- #
# Inputs shared by all variants                                               #
# --------------------------------------------------------------------------- #
# One-time stages: defined only when this run names them (ONCE). Otherwise their outputs are
# plain inputs that must exist, so a missing intermediate (an OSM layer, an image stamp) cannot
# pull the whole annotation chain back in. Downstream rules list the same inputs either way.
MERGE = wf.config("final_data_merge")["paths"]
if "combine_locations" in ONCE:
    rule combine_locations:
        """Corrected plant locations: OSM-snapped, segmentation results, national datasets (one job, in order)."""
        output:
            MERGE["corrected_all_filepath"],
            MERGE["new_points_filepath"],
        params: module="data_merge.correct_locations_w_OSM", cli=[]
        log: wf.log("combine_locations")
        threads: threads("combine_locations")
        resources: **res("combine_locations")
        shell:
            STAGE + then("data_merge.merge_seg_results", "--variant old") + then("data_merge.final_data_merge") + \
            then("data_merge.merge_seg_results", "--variant new")


GRIDS = wf.annotation_grid()
if "annotation_grids" in ONCE:
    rule annotation_grids:
        """One square tile per plant (NEW_01) and the OSM features in each tile (NEW_02)."""
        input: MERGE["corrected_all_filepath"]
        output:
            GRIDS,
            touch(wf.stamp("osm_extract")),
        params: module="annotation_scripts.NEW_01_GENERATEGRIDS", cli=[]
        log: wf.log("annotation_grids")
        threads: threads("annotation_grids")
        resources: **res("annotation_grids")
        shell: STAGE + then("annotation_scripts.NEW_02_EXTRACTOSMDATAFULL_GEOJSON")


if "wastewater_join" in ONCE:
    rule wastewater_join:
        """The OSM tiles merged into polygon and line layers (NEW_03), read by the image annotation."""
        input: GRIDS, wf.stamp("osm_extract")
        output: wf.osm_layers()
        params: module="annotation_scripts.NEW_03_WASTEWATERJOIN_GEOJSON", cli=[]
        log: wf.log("wastewater_join")
        threads: threads("wastewater_join")
        resources: **res("wastewater_join")
        shell: STAGE


BING_SHARDS = wf.config("workflow")["bing_annotate_shards"]
if "download_bing_annotate" in ONCE:
    rule download_bing_annotate:
        """Annotated imagery, one job per share of the tiles."""
        input: GRIDS, wf.osm_layers()
        output: touch(wf.stamp("bing_annotate_{shard}"))
        params:
            module="annotation_scripts.download_bing_annotate",
            cli=lambda w: [w.shard, "--num-instances", str(BING_SHARDS)],
        log: wf.log("bing_annotate_{shard}")
        threads: threads("download_bing_annotate")
        resources: **res("download_bing_annotate")
        shell: STAGE


MERGED_LABELS = wf.config("merge_annotations")["paths"]["annotated_all_filepath"]
if "merge_annotations" in ONCE:
    rule merge_annotations:
        """Plant types from the image labels (inference results come from outside this workflow).

        Waits for the image download only when this run downloads images too.
        """
        input:
            MERGE["corrected_all_filepath"],
            wf.config("merge_annotations")["paths"]["annotations_results_filepath"],
            expand(wf.stamp("bing_annotate_{shard}"), shard=range(BING_SHARDS))
            if "download_bing_annotate" in ONCE else [],
        output: MERGED_LABELS
        params: module="annotation_scripts.merge_annotations", cli=[]
        log: wf.log("merge_annotations")
        threads: threads("merge_annotations")
        resources: **res("merge_annotations")
        shell: STAGE


rule annotations:
    input: MERGED_LABELS


if "download_pop" in ONCE:
    rule download_pop:
        """WorldPop rasters of every country, start_year..end_year (one folder per country)."""
        output: touch(wf.stamp("download_pop"))
        params: module="download_pop", cli=[]
        log: wf.log("download_pop")
        threads: threads("download_pop")
        resources: **res("download_pop")
        shell: STAGE


for level in sorted({v.level for v in VARIANTS}):
    rule:
        name: f"combine_watersheds_lvl{level}"
        output: wf.watershed(level)
        params: module="combine_watersheds", cli=["--level", level]
        log: wf.log(f"combine_watersheds_lvl{level}")
        threads: threads("combine_watersheds")
        resources: **res("combine_watersheds")
        shell: STAGE

    rule:
        name: f"download_and_vectorize_lvl{level}"
        input: wf.watershed(level)
        output: wf.industrial_land(level, DEFAULT.version)
        params:
            module="industrial_analysis.download_and_vectorize",
            cli=["--level", level, "--version", DEFAULT.version],
        log: wf.log(f"download_and_vectorize_lvl{level}")
        threads: threads("download_and_vectorize")
        resources: **res("download_and_vectorize")
        shell: STAGE


# --------------------------------------------------------------------------- #
# Service areas and population, per variant                                   #
# --------------------------------------------------------------------------- #
ANNOTATED = wf.config("create_voronoi")["paths"]["annotated_all_filepath"]
TAGS = {v.tag for v in VARIANTS}
for v in VARIANTS:
    for a in wf.approaches(v):
        source = wf.approach0_source(v) if a == "0" else None
        if source is not None and source.tag in TAGS:
            # Approach 0 never reads the basins: the same files as at the shared level, hard-linked
            # (every stage replaces its outputs, so the two names cannot drift apart).
            # One rule per file: a link has its source's modification time, which must not be older
            # than any input of its rule.
            rule:
                name: f"share_approach0__{v.tag}"
                input: wf.service_areas(source, "0")
                output: wf.service_areas(v, "0")
                localrule: True
                shell: "ln -f {input} {output}"

            rule:
                name: f"share_approach0_pop__{v.tag}"
                input: wf.population_layer(source, "0")
                output: wf.population_layer(v, "0")
                localrule: True
                shell: "ln -f {input} {output}"
            continue

        rule:
            name: f"create_voronoi__{v.tag}__a{a}"
            input: ANNOTATED, wf.watershed(v.level)
            output: wf.service_areas(v, a)
            params: module="create_voronoi", cli=["--approach", a, *v.cli()], **wf.sizing_params(v)
            log: wf.log(f"create_voronoi_a{a}", v)
            threads: threads("create_voronoi")
            resources: **res("create_voronoi")
            shell: STAGE

        rule:
            name: f"add_pop__{v.tag}__a{a}"
            input: wf.service_areas(v, a), wf.stamp("download_pop")
            output: wf.population_layer(v, a)
            params: module="add_pop", cli=["--approach", a, *v.cli()]
            log: wf.log(f"add_pop_a{a}", v)
            threads: threads("add_pop")
            resources: **res("add_pop")
            shell: STAGE


    rule:
        name: f"find_unconnected_industrial_areas__{v.tag}"
        input: wf.industrial_land(v.level, v.version), ANNOTATED, wf.watershed(v.level)
        output: wf.config("find_unconnected_industrial_areas", v)["paths"]["industrial_unconnected_output"]
        params: module="industrial_analysis.find_unconnected_industrial_areas", cli=v.cli()
        log: wf.log("find_unconnected_industrial_areas", v)
        threads: threads("find_unconnected_industrial_areas")
        resources: **res("find_unconnected_industrial_areas")
        shell: STAGE


rule sweep_layers:
    """Service areas and population of every variant of the sweep."""
    input: [wf.population_layer(v, a) for v in SWEEP for a in wf.approaches(v)]


ND = wf.config("national_data")["paths"]
rule national_data_fetch:
    """Reference files of the validation and national plant registers, downloaded (needs internet: local).

    Only the stamp is an output: Snakemake deletes the outputs of a failed job, and a failed download
    must not take the files that are already there with it.
    """
    localrule: True
    output: touch(wf.stamp("national_data_fetch"))
    params: module="pop_validation_scripts.national_data", cli=["fetch"], **wf.settings_params("national_data", "sources", "request_headers")
    log: wf.log("national_data_fetch")
    shell: STAGE


rule national_registers:
    """The downloaded files described, and the register plants our list lacks, in one file."""
    input: ANNOTATED, wf.stamp("national_data_fetch")
    output: [f"{ND['output_dir']}/{name}" for name in ("results.zip", "new_plants.gpkg", "new_plants.csv", "register_plants.gpkg", "register_plants.csv", "registers_summary.csv", "peek.md")]
    params: module="pop_validation_scripts.national_data", cli=["registers"], **wf.settings_params("national_data", "registers", "coordinate_names", "match_distance_m", "uncovered")
    log: wf.log("national_registers")
    threads: threads("national_registers")
    resources: **res("national_registers")
    shell: STAGE


rule national_data:
    """Reference data downloaded and the new plants of the national registers listed."""
    input: rules.national_registers.output


SV = wf.config("sweep_validation")["paths"]
rule sweep_validation_references:
    """Plants, ver/unver/single groups, reference units (GB, NL, US, HydroWASTE, UWWTD) and countries (JMP, Eurostat, OECD), once."""
    input:
        wf.population_layer(DEFAULT, wf.figure_approach(DEFAULT)),
        wf.stamp("national_data_fetch"),  # the reference files (national_data.sources with required)
        SV["eu_ref_filepath"],
    output: [f"{SV['output_dir']}/references/{name}" for name in ("plants.csv", "units.csv", "matches.csv", "gb_catchments.gpkg", "national.csv")]
    params: module="sensitivity_analysis_scripts.sweep_validation", cli=["references"]
    log: wf.log("sweep_validation_references")
    threads: threads("sweep_validation_references")
    resources: **res("sweep_validation_references")
    shell: STAGE


rule sweep_validation:
    """Every candidate of the sweep against plants and countries; scores and the recommended candidate."""
    input: rules.sweep_layers.input, rules.sweep_validation_references.output
    output: [f"{SV['output_dir']}/{name}" for name in ("scores.csv", "national_scores.csv", "national_countries.csv", "national_regions.csv", "choice.csv", "summary.md", "units.parquet", "results.zip")]
    params: module="sensitivity_analysis_scripts.sweep_validation", cli=["score"]
    log: wf.log("sweep_validation")
    threads: threads("sweep_validation")
    resources: **res("sweep_validation")
    shell: STAGE


rule sweep:
    """The sweep grid: service areas + population of every variant, validated, and the choice."""
    input: rules.sweep_layers.input, rules.sweep_validation.output


# --------------------------------------------------------------------------- #
# Non-served population and downstream risk, configured variant               #
# --------------------------------------------------------------------------- #
v = DEFAULT
SHARDS = wf.raster_shards(v)
FIG = wf.population_layer(v, wf.figure_approach(v))
RISK = {s: wf.config(s, v)["paths"] for s in ("find_unserved_pop", "assign_rivers_to_basin", "find_intersection_river",
                                              "find_pop_in_danger_pop", "find_unconnected_industrial_areas")}

for i in range(SHARDS if SHARDS > 1 else 0):
    rule:
        name: f"create_rasters__{v.tag}__shard{i}"
        input: FIG, wf.watershed(v.level), wf.stamp("download_pop")
        output: wf.raster_shard_files(v, i)
        params:
            module="pop_at_risk_river_calculations.create_rasters",
            cli=["--job-index", str(i), "--total-jobs", str(SHARDS), *v.cli()],
        log: wf.log(f"create_rasters_shard{i}", v)
        threads: threads("create_rasters")
        resources: **res("create_rasters")
        shell: STAGE

rule:
    name: f"create_rasters__{v.tag}"
    input: [f for i in range(SHARDS) for f in wf.raster_shard_files(v, i)] if SHARDS > 1 else \
        [FIG, wf.watershed(v.level), wf.stamp("download_pop")]
    output: wf.raster_stats(v)
    params:
        module="pop_at_risk_river_calculations.create_rasters",
        cli=(["--merge-shards", str(SHARDS)] if SHARDS > 1 else []) + v.cli(),
    log: wf.log("create_rasters", v)
    threads: threads("create_rasters")
    resources: **res("create_rasters")
    shell: STAGE

rule:
    name: f"find_unserved_pop__{v.tag}"
    input: wf.raster_stats(v)[1], ANNOTATED
    output: RISK["find_unserved_pop"]["non_served_above_threshold_outpath"]
    params: module="pop_at_risk_river_calculations.find_unserved_pop", cli=v.cli()
    log: wf.log("find_unserved_pop", v)
    threads: threads("find_unserved_pop")
    resources: **res("find_unserved_pop")
    shell: STAGE

rule:
    name: f"assign_rivers_to_basin__{v.tag}"
    input: wf.watershed(v.level)
    output: RISK["assign_rivers_to_basin"]["rivershed_output_path"]
    params:
        module="pop_at_risk_river_calculations.assign_rivers_to_basin",
        cli=["--max-workers", str(threads("assign_rivers_to_basin")), *v.cli()],
    log: wf.log("assign_rivers_to_basin", v)
    threads: threads("assign_rivers_to_basin")
    resources: **res("assign_rivers_to_basin")
    shell: STAGE

rule:
    name: f"find_intersection_river__{v.tag}"
    input:
        RISK["find_unserved_pop"]["non_served_above_threshold_outpath"],
        RISK["assign_rivers_to_basin"]["rivershed_output_path"],
    output: RISK["find_intersection_river"]["non_served_nxt_river_outpath"]
    params:
        module="pop_at_risk_river_calculations.find_intersection_river",
        cli=["--max-workers", str(threads("find_intersection_river")), *v.cli()],
    log: wf.log("find_intersection_river", v)
    threads: threads("find_intersection_river")
    resources: **res("find_intersection_river")
    shell: STAGE

rule:
    name: f"impact_polygons_pop__{v.tag}"
    input:
        RISK["find_intersection_river"]["non_served_nxt_river_outpath"],
        RISK["assign_rivers_to_basin"]["rivershed_output_path"],
    output: wf.impact_polygons(v)
    params:
        module="pop_at_risk_river_calculations.impact_polygons_pop",
        cli=["--max-workers", str(threads("impact_polygons_pop")), *v.cli()],
    log: wf.log("impact_polygons_pop", v)
    threads: threads("impact_polygons_pop")
    resources: **res("impact_polygons_pop")
    shell: STAGE

rule:
    name: f"find_pop_in_danger_pop__{v.tag}"
    input: wf.impact_polygons(v), wf.stamp("download_pop")
    output: RISK["find_pop_in_danger_pop"]["pop_at_risk_output_filepath"]
    params: module="pop_at_risk_river_calculations.find_pop_in_danger_pop", cli=v.cli()
    log: wf.log("find_pop_in_danger_pop", v)
    threads: threads("find_pop_in_danger_pop")
    resources: **res("find_pop_in_danger_pop")
    shell: STAGE

rule:
    name: f"find_diff_pop__{v.tag}"
    input: FIG, wf.watershed(v.level), wf.stamp("download_pop")
    output: wf.diff_layer(v)
    params: module="pop_at_risk_river_calculations.find_diff_pop", cli=["--is-parallel", "true", *v.cli()]
    log: wf.log("find_diff_pop", v)
    threads: threads("find_diff_pop")
    resources: **res("find_diff_pop")
    shell: STAGE

# Validation against HydroWASTE and the UWWTD: split, then plots (their file lists depend on the data).
rule:
    name: f"verification_script__{v.tag}"
    input: [wf.population_layer(v, a) for a in wf.approaches(v)]
    output: touch(wf.stamp("verification_script", v))
    params: module="pop_validation_scripts.verification_script", cli=v.cli()
    log: wf.log("verification_script", v)
    threads: threads("verification_script")
    resources: **res("verification_script")
    shell: STAGE

for comparison in ("hw_comparison", "eu_comparison"):
    rule:
        name: f"{comparison}__{v.tag}"
        input: wf.stamp("verification_script", v)
        output: touch(wf.stamp(comparison, v))
        params: module=f"pop_validation_scripts.{comparison}", cli=v.cli()
        log: wf.log(comparison, v)
        threads: threads(comparison)
        resources: **res(comparison)
        shell: STAGE

FIGURE_INPUTS = {
    "piechart_figure": [FIG, wf.raster_stats(v)[0]],
    "piechart_interactive": [FIG, wf.raster_stats(v)[0]],
    "sizes_interactive_map": [FIG],
    "composite_area_population_plots": [FIG],
    "pop_at_risk_figures": [RISK["find_unserved_pop"]["non_served_above_threshold_outpath"],
                            RISK["find_pop_in_danger_pop"]["pop_at_risk_output_filepath"]],
    "interactive_unconnected_industrial_map": [RISK["find_unconnected_industrial_areas"]["industrial_unconnected_output"]],
}
for figure, figure_inputs in FIGURE_INPUTS.items():
    rule:
        name: f"{figure}__{v.tag}"
        input: figure_inputs
        output: touch(wf.stamp(figure, v))
        params: module=f"figures_scripts.{figure}", cli=v.cli()
        log: wf.log(figure, v)
        threads: threads(figure)
        resources: **res(figure)
        shell: STAGE

rule:
    name: f"figures__{v.tag}"
    input: [wf.stamp(figure, v) for figure in FIGURE_INPUTS]
    output: touch(wf.stamp("figures", v))


# --------------------------------------------------------------------------- #
# Targets: each part on its own, `all` for every part                         #
# --------------------------------------------------------------------------- #
rule service_areas:
    """Service areas and population layers of every approach, compared with HydroWASTE and the UWWTD."""
    input:
        [wf.population_layer(v, a) for a in wf.approaches(v)],
        wf.stamp("hw_comparison", v),
        wf.stamp("eu_comparison", v),


rule risk:
    """Non-served population, river risk, population differences, unconnected industrial areas."""
    input:
        RISK["find_pop_in_danger_pop"]["pop_at_risk_output_filepath"],
        wf.diff_layer(v),
        RISK["find_unconnected_industrial_areas"]["industrial_unconnected_output"],


rule analysis:
    input: rules.service_areas.input, rules.risk.input


rule figures:
    input: wf.stamp("figures", v)


rule all:
    input: rules.analysis.input, rules.figures.input, rules.sweep.input


# --------------------------------------------------------------------------- #
# Calibration: service-radius scale from the national connection rate          #
# (wwtp/calibration/connection_radius.py; settings: connection_radius)        #
# --------------------------------------------------------------------------- #
CR = wf.config("connection_radius")["paths"]["output_dir"]
rule connection_radius_references:
    """National connection statistics, saved unparsed. A local job: compute nodes may have no internet."""
    output: f"{CR}/references/manifest.json"
    params: module="calibration.connection_radius", cli=["references"]
    log: wf.log("connection_radius_references")
    localrule: True
    shell: PY + " -m wwtp.{params.module} {params.cli:q} > {log} 2>&1"


# Settings whose change reruns the step (rule params; see wf.settings_params)
CURVE_SETTINGS = ("year", "aggregate_cells", "candidate_plants", "size_measures", "radius_exponents", "radius_grid",
                  "max_buffer", "footprint_to_people", "reported_size_columns", "reported_size_skip")
CALIBRATE_SETTINGS = ("footprint_to_people", "size_country_min_plants", "fit_reference", "reference_series",
                      "reference_max_year_gap", "calibration_caps_km", "calibration_size_scale_limits",
                      "check_references", "sdg631")
PLANT_CHECK_SETTINGS = ("year", "aggregate_cells", "candidate_plants", "plant_reference_kinds",
                        "plant_reference_polygons", "polygon_match_distance_m", "district_references",
                        "choice_national", "plant_bootstrap_samples", "plant_bootstrap_seed", "plant_confidence")
rule connection_radius_curves:
    """Served share against the radius scale for every country with plants and a WorldPop raster."""
    input: ANNOTATED, wf.stamp("download_pop")
    output: f"{CR}/countries.csv", f"{CR}/served_share_curves.csv", f"{CR}/plants.csv"
    params: module="calibration.connection_radius", cli=["curves"], **wf.settings_params("connection_radius", *CURVE_SETTINGS)
    log: wf.log("connection_radius_curves")
    threads: threads("connection_radius_curves")
    resources: **res("connection_radius_curves")
    shell: STAGE


rule connection_radius_calibrate:
    """Country parts of the plant size, the national size scale and the radius rule (light: local)."""
    input: rules.connection_radius_references.output, rules.connection_radius_curves.output, wf.stamp("national_data_fetch")
    output: [f"{CR}/{name}" for name in ("reference_table.csv", "plant_size_countries.csv", "calibration_by_cap.csv", "calibration_countries.csv")]
    params: module="calibration.connection_radius", cli=["calibrate"], **wf.settings_params("connection_radius", *CALIBRATE_SETTINGS)
    log: wf.log("connection_radius_calibrate")
    localrule: True
    shell: STAGE


rule connection_radius_plant_check:
    """Every calibrate configuration on the real catchments (US, GB, NL, IE, ES, ...) and census districts; the choice."""
    input: rules.connection_radius_calibrate.output, wf.stamp("national_data_fetch"), wf.stamp("download_pop")
    output: [f"{CR}/{name}" for name in ("plant_references.csv", "plant_check_status.csv", "plant_check.csv", "district_check.csv", "plant_units.csv.gz", "plant_choice.csv", "plant_configurations.csv")]
    params: module="calibration.plant_check", cli=["run"], **wf.settings_params("connection_radius", *PLANT_CHECK_SETTINGS)
    log: wf.log("connection_radius_plant_check")
    threads: threads("connection_radius_plant_check")
    resources: **res("connection_radius_plant_check")
    shell: STAGE


rule connection_radius:
    input: rules.connection_radius_plant_check.output


rule calibration_results:
    """The calibration tables and the national_data results in one file to send back."""
    input: rules.connection_radius_plant_check.output, rules.national_registers.output
    output: f"{CR}/calibration_results.zip"
    params: module="calibration.connection_radius", cli=["pack"]
    log: wf.log("calibration_results")
    localrule: True
    shell: STAGE


rule calibration:
    """Everything the calibration needs from the cluster; the sweep runs after its values are in config.yaml."""
    input: rules.calibration_results.output


